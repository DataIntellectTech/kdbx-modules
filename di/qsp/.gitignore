# kept in the module, so a copy of di/qsp - into kdbx-modules, say - ignores the same things
# a database built inside the example while trying it out (hdb.q builds in $TMPDIR by default)
examples/**/*db/
# written by bin/harden.sh
harden-output/
# written by bin/ci.sh
ci-output/
# ...but this one is a policy, for the surveillance database the agent eval is asked about
!examples/equities/policylargeequitiesdb/
# written by examples/agents/eval/run.py: transcripts, and what each run cost
examples/agents/eval/runs/
# Python's bytecode cache, written by the eval harness
__pycache__/
